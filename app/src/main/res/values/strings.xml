    <!-- The test call -->
    <string name="test_title">Check this phone</string>
    <string name="test_intro">Twenty seconds tells us the truth about your phone: whether the other person really ends up in the recording, or only you.</string>
    <string name="test_step_1">Tap Start, then call anyone — your voicemail is easiest.</string>
    <string name="test_step_2">Talk for the first five seconds.</string>
    <string name="test_step_3">Then stay quiet for ten seconds and let the other side talk. Hang up.</string>
    <string name="test_start">Start the check</string>
    <string name="test_waiting">Waiting for your call…</string>
    <string name="test_recording">Listening. Stay quiet now and let the other side talk.</string>
    <string name="test_result_both">Both of you are in the recording. This phone is covered.</string>
    <string name="test_result_one">Only you are in the recording on this phone. Saving on the speaker is the way that works here.</string>
    <string name="test_result_nothing">Nothing was recorded on this phone that way.</string>
    <string name="test_again">Check again</string>
    <string name="test_wifi_hint">One more thing to try: calls over Wi-Fi are often silent to any recorder. Turn off \"Wi-Fi calling\", then check again.</string>
    <string name="test_wifi_open">Open Wi-Fi calling settings</string>
    <string name="test_nothing_checked">Not checked on this phone yet.</string>

