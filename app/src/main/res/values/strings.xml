    <!-- Permissions: one title and one reason each, in her words, never Android's -->
    <string name="perm_microphone_title">Allow the microphone</string>
    <string name="perm_microphone_why">Without this nothing can be saved at all. Tap Allow and choose \"While using the app\".</string>
    <string name="perm_call_state_title">Allow calls to be noticed</string>
    <string name="perm_call_state_why">So the app knows a call has started and can begin saving by itself.</string>
    <string name="perm_call_log_title">Allow the call list</string>
    <string name="perm_call_log_why">So each saved call shows the number and whether you called or were called.</string>
    <string name="perm_contacts_title">Allow contacts</string>
    <string name="perm_contacts_why">So your lists show names instead of numbers. You can skip this one.</string>
    <string name="perm_notifications_title">Allow the quiet notice</string>
    <string name="perm_notifications_why">Android shows a small notice while the app is watching. You can skip this one.</string>
    <string name="setup_allow">Allow</string>

    <!-- The two ways of saving a call -->
    <string name="route_shizuku_label">Quietly, during the call</string>
    <string name="route_speakerphone_label">Out loud, on the speaker</string>
    <string name="route_speakerphone_voip_label">Calls in other apps, on the speaker</string>

    <!-- Speakerphone guide -->
    <string name="guide_speaker_headline">Save calls on the speaker</string>
    <string name="guide_speaker_1_title">Know what this does</string>
    <string name="guide_speaker_1_detail">The call goes to the speaker and the microphone saves both of you. It works on every phone — but anyone in the room hears the call.</string>
    <string name="guide_speaker_2_title">Turn it on</string>
    <string name="guide_speaker_2_detail">Go to Settings in this app and turn on saving on the speaker. You can turn it off again at any time.</string>
    <string name="guide_speaker_keep_audible">While this is on, calls you save are heard out loud. Turn it off when someone is nearby.</string>

    <!-- Calls inside other apps -->
    <string name="guide_voip_headline">Calls in WhatsApp, Viber, Messenger</string>
    <string name="guide_voip_2_title">Turn on saving for those calls</string>
    <string name="guide_voip_2_detail">Those calls can only be saved on the speaker. If this is off, the app still writes down that the call happened and that it was not saved.</string>

