<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Knowing a call is happening, and who it is with. Android 12 stopped
         giving the number to call-state listeners, so the call log is the only
         place left that says who called and in which direction. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Capturing, and the visible service that must accompany it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bring the ear back after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The lock on the door. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Android 11 hides other packages from us unless we name them. Without this,
      getPackageInfo("moe.shizuku.privileged.api") throws for a Shizuku that has
      not yet talked to this app — exactly the state after a reboot — and the app
      would tell a user whose Shizuku merely needs restarting to go and install
      it. One package, named, rather than the QUERY_ALL_PACKAGES sledgehammer.
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".ToolboxApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Toolbox"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Toolbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The always-on ear: watches call state, hosts the recording. -->
        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".capture.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Shizuku's provider: the app-side half of the bridge to the privileged
          process. The authority and permission are fixed by the Shizuku SDK.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          Sharing hands out a COPY from the cache, never the vault file. The
          granted URI is temporary and the copy is wiped as soon as the screen
          that produced it goes away (Vault.purgeScratch).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>

    </application>

</manifest>
